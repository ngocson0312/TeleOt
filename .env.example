# Copy thành .env rồi điền. KHÔNG commit file .env.

# Token bot Telegram (tạo qua @BotFather)
TELEGRAM_BOT_TOKEN=

# Khóa mã hóa client secret KiotViet trong CSDL.
# Tạo bằng: python -m app.cli gen-key
SECRET_KEY=

# Chat của người vận hành, nhận báo lỗi đồng bộ (lấy bằng lệnh /id trong chat với bot)
ADMIN_CHAT_ID=

# Mặc định: SQLite trong thư mục data/
# DATABASE_URL=sqlite:///data/teleot.db

# LOG_LEVEL=INFO

# Chỉ dùng cho giai đoạn 0 (python -m app.cli probe --from-env).
# Lấy ở KiotViet: Thiết lập cửa hàng -> Thiết lập kết nối API.
KIOTVIET_RETAILER=
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
